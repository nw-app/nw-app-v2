{
  "firestore": {
    "rules": "firebase/firebase.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firebase/**"
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/community", "destination": "/admin.html" },
      { "source": "/system", "destination": "/system.html" },
      { "source": "/member", "destination": "/member.html" }
    ],
    "headers": [
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
        ]
      }
    ]
  }
}

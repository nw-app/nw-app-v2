rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "nwapp.eason@gmail.com"
          || request.auth.token.role == "admin"
          || request.auth.token.role == "系統管理員"
          || request.auth.token.role == "系統管理者"
          || request.auth.token.role == "系統"
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["admin", "系統管理員", "系統管理者", "系統"]
          )
        );
    }

    function isCommunityStaff() {
       return request.auth != null
         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["住戶", "resident", "停用"]);
    }

    function asString(v) {
      return v is string ? v : "";
    }

    function userUnitKeys() {
      let ud = getUserData();
      let unitBase = asString(ud.get('houseNo', ''));
      let unitBase2 = asString(ud.get('unit', ''));
      let subA = asString(ud.get('subHouseNo', ''));
      let subB = asString(ud.get('subUnit', ''));
      let subC = asString(ud.get('sub', ''));
      let fullA = (unitBase != "" && subA != "") ? (unitBase + "-" + subA) : "";
      let fullB = (unitBase != "" && subB != "") ? (unitBase + "-" + subB) : "";
      let fullC = (unitBase != "" && subC != "") ? (unitBase + "-" + subC) : "";
      return [unitBase, unitBase2, fullA, fullB, fullC];
    }

    function isVisitorSelfCreate(visitorId) {
      return request.auth != null
        && request.resource.data.keys().hasOnly([
          "qrToken",
          "name",
          "email",
          "phone",
          "unit",
          "partySize",
          "plate",
          "purpose",
          "purposeType",
          "purposeOther",
          "note",
          "inAt",
          "outAt",
          "keep",
          "source",
          "status",
          "passAuthorized",
          "passAuthorizedAt",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.source == "self"
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == "訪客自填"
        && request.resource.data.qrToken == visitorId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 80
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.purposeType is string
        && request.resource.data.purposeType.size() <= 20
        && request.resource.data.purposeOther is string
        && request.resource.data.purposeOther.size() <= 40
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.keep == null
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.passAuthorized == false
        && request.resource.data.passAuthorizedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorPublicCreate(visitorId, slug) {
      return request.auth == null
        && request.resource.data.keys().hasOnly([
          "qrToken",
          "name",
          "email",
          "phone",
          "unit",
          "partySize",
          "plate",
          "purpose",
          "purposeType",
          "purposeOther",
          "note",
          "inAt",
          "outAt",
          "keep",
          "source",
          "status",
          "passAuthorized",
          "passAuthorizedAt",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.source == "self"
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == "public"
        && request.resource.data.createdByName == "訪客自填"
        && request.resource.data.qrToken == visitorId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 80
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.purposeType is string
        && request.resource.data.purposeType.size() <= 20
        && request.resource.data.purposeOther is string
        && request.resource.data.purposeOther.size() <= 40
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.keep == null
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.passAuthorized == false
        && request.resource.data.passAuthorizedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorSelfGet() {
      return request.auth != null
        && resource.data.get('source', '') == "self"
        && resource.data.get('createdBy', '') == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if (request.auth != null && (
        request.auth.uid == uid || 
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      )) || (
        resource.data.status == "pending" && resource.data.role == "resident"
      );
      
      allow create: if (request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && request.resource.data.community == getUserData().community)
      )) || (
        request.resource.data.role == "resident" &&
        request.resource.data.status == "pending" &&
        request.resource.data.enabled == false &&
        request.resource.data.community is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.phone is string &&
        (request.resource.data.houseNo == null || request.resource.data.houseNo is string) &&
        (request.resource.data.password == null || request.resource.data.password is string) &&
        (request.resource.data.avatarDataUrl == null || request.resource.data.avatarDataUrl is string)
      );
      
      allow update: if request.auth != null && (
        request.auth.uid == uid || 
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );
      
      allow delete: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );

      match /wallet/{walletId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /parking_earnings/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    match /user_lookup/{phone} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /communities/{slug} {
      allow read: if true;
      allow update: if request.auth != null && (
        isAdmin() || (
          isCommunityStaff() && (
            slug == getUserData().community
            || resource.data.get('username', '') == getUserData().community
            || resource.data.get('id', '') == getUserData().community
          )
        )
      );
      allow create, delete: if isAdmin();
      
      match /app_modules/{module} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /announcements/{announceId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /bulletins/{bulletinId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /parking_spots/{spotId} {
        allow read: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) || 
          (slug == getUserData().community)
        );
      }

      match /parking_residents/{docId} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community || docId == request.auth.uid || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community) || docId == request.auth.uid || resource.data.uid == request.auth.uid);
      }

      match /parking_income_daily/{dayId} {
        allow read: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /parking_notifications/{nid} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /facility_configs/{configId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /reservations/{resId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          resource.data.createdBy == request.auth.uid
        );
      }

      match /mails/{mailId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          (getUserData().houseNo == resource.data.houseNo)
        );
        allow write: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /parcels/{parcelId} {
        allow read, write: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          (resource.data.unit in userUnitKeys()) ||
          (resource.data.houseNo in userUnitKeys())
        );
      }
      
      // 允許列出包裹集合（用於調試）
      match /parcels {
        allow list: if request.auth != null;
      }

      match /visitors/{visitorId} {
        allow get: if (request.auth != null && (
            isAdmin()
            || (
              isCommunityStaff()
              && (
                slug == getUserData().community
                || get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') == getUserData().community
                || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') == getUserData().community
              )
            )
            || isVisitorSelfGet()
          )) || (
            request.auth == null
            && resource.data.get('source', '') == "self"
            && resource.data.get('createdBy', '') == "public"
          );
        allow list: if request.auth != null && (
          isAdmin()
          || (
            isCommunityStaff()
            && (
              slug == getUserData().community
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') == getUserData().community
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') == getUserData().community
            )
          )
        );
        allow create: if (request.auth != null && (
            isAdmin()
            || (
              isCommunityStaff()
              && (
                slug == getUserData().community
                || get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') == getUserData().community
                || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') == getUserData().community
              )
            )
            || isVisitorSelfCreate(visitorId)
          )) || isVisitorPublicCreate(visitorId, slug);
        allow update, delete: if request.auth != null && (
          isAdmin()
          || (
            isCommunityStaff()
            && (
              slug == getUserData().community
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') == getUserData().community
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') == getUserData().community
            )
          )
        );
      }

      match /points_logs/{logId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          resource.data.houseNo == getUserData().houseNo
        );
        allow create: if request.auth != null;
      }

      match /pending_accounts/{reqId} {
        allow create: if request.resource.data.community == slug
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt is int
          && request.resource.data.get('photoDataUrl', '') is string
          && request.resource.data.houseNo is string
          && request.resource.data.displayName is string
          && request.resource.data.phone is string
          && request.resource.data.get('address', '') is string
          && request.resource.data.email is string
          && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.password is string
          && request.resource.data.password.matches('^[A-Za-z0-9]{6,}$');

        allow read, list, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /house_nos/{houseNoId} {
        allow read, list: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
        allow create, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /parking_schedules/{sid} {
        allow read: if request.auth != null && (isAdmin() || slug == getUserData().community || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (slug == getUserData().community && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid)));
      }

      match /parking_bookings/{bid} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (isAdmin() || slug == getUserData().community);
      }
    }

    match /sos_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );
    }

    match /mail/{mailId} {
      allow create: if request.auth != null && (isAdmin() || isCommunityStaff());
      allow read, update, delete: if isAdmin();
    }

    // --- 點數歷史紀錄 ---
    match /pointsHistory/{historyId} {
      allow read, write: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && resource.data.communityId == getUserData().community) ||
        resource.data.userId == request.auth.uid
      );
    }

    function callExists(callId) {
      return exists(/databases/$(database)/documents/calls/$(callId));
    }

    function callData(callId) {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }

    function isCallParticipantByDoc(doc) {
      return request.auth != null && (
        doc.fromUid == request.auth.uid ||
        doc.toUid == request.auth.uid ||
        isAdmin() ||
        (isCommunityStaff() && doc.community == getUserData().community)
      );
    }

    function isCallParticipant(callId) {
      return callExists(callId) && isCallParticipantByDoc(callData(callId));
    }

    match /calls/{callId} {
      allow create: if request.auth != null && (
        (
          request.resource.data.community == getUserData().community &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.fromRole in ["resident", "admin"] &&
          request.resource.data.status == "ringing"
        )
        ||
        isAdmin()
      );

      allow read: if request.auth != null && isCallParticipantByDoc(resource.data);

      allow update: if request.auth != null && isCallParticipantByDoc(resource.data);

      allow delete: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );

      match /offerCandidates/{candidateId} {
        allow read, create: if request.auth != null && isCallParticipant(callId);
        allow update, delete: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read, create: if request.auth != null && isCallParticipant(callId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return (request.auth != null && request.auth.token.email == "nwapp.eason@gmail.com")
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "系統管理員"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "系統管理者"
            )
          );
    }

    function isCommunityStaff() {
       return exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') != "住戶"
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') != "停用";
    }

    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );
      
      allow create: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && request.resource.data.community == getUserData().community)
      );
      
      allow update: if request.auth != null && (
        request.auth.uid == uid || 
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );
      
      allow delete: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );

      match /wallet/{walletId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /parking_earnings/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    match /user_lookup/{phone} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /communities/{slug} {
      allow read: if true;
      allow update: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      allow create, delete: if isAdmin();
      
      match /app_modules/{module} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /announcements/{announceId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /parking_spots/{spotId} {
        allow read: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) || 
          (slug == getUserData().community)
        );
      }

      match /parking_residents/{docId} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community || docId == request.auth.uid || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community) || docId == request.auth.uid || resource.data.uid == request.auth.uid);
      }

      match /parking_income_daily/{dayId} {
        allow read: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /parking_notifications/{nid} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /facility_configs/{configId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && slug == getUserData().community));
      }

      match /reservations/{resId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          resource.data.createdBy == request.auth.uid
        );
      }

      match /mails/{mailId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          (getUserData().houseNo == resource.data.houseNo)
        );
        allow write: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /visitors/{visitorId} {
        allow read, list: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
        allow create, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /points_logs/{logId} {
        allow read: if request.auth != null && (
          isAdmin() || 
          (isCommunityStaff() && slug == getUserData().community) ||
          resource.data.houseNo == getUserData().houseNo
        );
        allow create: if request.auth != null;
      }

      match /pending_accounts/{reqId} {
        allow create: if request.resource.data.community == slug
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt is int
          && request.resource.data.get('photoDataUrl', '') is string
          && request.resource.data.houseNo is string
          && request.resource.data.displayName is string
          && request.resource.data.phone is string
          && request.resource.data.get('address', '') is string
          && request.resource.data.email is string
          && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.password is string
          && request.resource.data.password.matches('^[A-Za-z0-9]{6,}$');

        allow read, list, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /house_nos/{houseNoId} {
        allow read, list: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
        allow create, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && slug == getUserData().community)
        );
      }

      match /parking_schedules/{sid} {
        allow read: if request.auth != null && (isAdmin() || slug == getUserData().community || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (slug == getUserData().community && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid)));
      }

      match /parking_bookings/{bid} {
        allow read, list: if request.auth != null && (isAdmin() || slug == getUserData().community);
        allow write: if request.auth != null && (isAdmin() || slug == getUserData().community);
      }
    }

    match /sos_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        isAdmin() || 
        (isCommunityStaff() && resource.data.community == getUserData().community)
      );
    }

    match /mail/{mailId} {
      allow create: if request.auth != null && (isAdmin() || isCommunityStaff());
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "nwapp.eason@gmail.com"
          || request.auth.token.role == "admin"
          || request.auth.token.role == "系統管理員"
          || request.auth.token.role == "系統管理者"
          || request.auth.token.role == "系統"
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["admin", "系統管理員", "系統管理者", "系統"]
          )
        );
    }

    function isCommunityStaff() {
       return request.auth != null
         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["住戶", "resident", "停用"]);
    }

    function asString(v) {
      return v is string ? v : "";
    }

    function dashVariant(s) {
      return asString(s).split("-").join("－");
    }

    function baseVariant(s) {
      let parts = asString(s).split("-");
      return parts.size() > 0 ? parts[0] : "";
    }

    function expandUnitKey(v) {
      let sv = asString(v);
      let withSelf = sv != "" ? [sv] : [];
      let d = dashVariant(sv);
      let withDash = withSelf + ((sv != "" && d != sv) ? [d] : []);
      let b = baseVariant(sv);
      let withBase = withDash + ((sv != "" && b != "" && b != sv) ? [b] : []);
      let bd = dashVariant(b);
      return withBase + ((sv != "" && b != "" && b != sv && bd != b) ? [bd] : []);
    }

    function userCommunityIds() {
      let ud = getUserData();
      let ids = ud.get('communityIds', []);
      return ids is list ? ids : [];
    }

    function userCanAccessUserCommunity(communityId) {
      let key = asString(communityId);
      let ud = getUserData();
      let primary = asString(ud.get('community', ''));
      let ids = userCommunityIds();
      return key != ""
        && (
          key == primary
          || key in ids
          || (
            primary != ""
            && exists(/databases/$(database)/documents/communities/$(primary))
            && (
              get(/databases/$(database)/documents/communities/$(primary)).data.get('username', '') == key
              || get(/databases/$(database)/documents/communities/$(primary)).data.get('id', '') == key
            )
          )
          || (
            exists(/databases/$(database)/documents/communities/$(key))
            && (
              get(/databases/$(database)/documents/communities/$(key)).data.get('username', '') == primary
              || get(/databases/$(database)/documents/communities/$(key)).data.get('id', '') == primary
              || get(/databases/$(database)/documents/communities/$(key)).data.get('username', '') in ids
              || get(/databases/$(database)/documents/communities/$(key)).data.get('id', '') in ids
            )
          )
        );
    }

    function userCanAccessCommunitySlug(slug) {
      let key = asString(slug);
      let primary = asString(getUserData().get('community', ''));
      let ids = userCommunityIds();
      return key != ""
        && (
          key == primary
          || key in ids
          || (
            exists(/databases/$(database)/documents/communities/$(slug))
            && (
              get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') == primary
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') == primary
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('username', '') in ids
              || get(/databases/$(database)/documents/communities/$(slug)).data.get('id', '') in ids
            )
          )
        );
    }

    function userUnitKeys() {
      let ud = getUserData();
      let unitBase = asString(ud.get('houseNo', ''));
      let unitBase2 = asString(ud.get('unit', ''));
      let subA = asString(ud.get('subHouseNo', ''));
      let subB = asString(ud.get('subUnit', ''));
      let subC = asString(ud.get('sub', ''));
      let fullA = (unitBase != "" && subA != "") ? (unitBase + "-" + subA) : "";
      let fullB = (unitBase != "" && subB != "") ? (unitBase + "-" + subB) : "";
      let fullC = (unitBase != "" && subC != "") ? (unitBase + "-" + subC) : "";
      return expandUnitKey(unitBase)
           + expandUnitKey(unitBase2)
           + expandUnitKey(fullA)
           + expandUnitKey(fullB)
           + expandUnitKey(fullC);
    }

    function isVisitorSelfGet() {
      return request.auth == null
        && resource.data.get('source', '') == "self"
        && resource.data.get('createdBy', '') == "public";
    }

    function isVisitorSelfCreate(visitorId) {
      return request.auth != null
        && request.resource.data.keys().hasOnly([
          "qrToken",
          "name",
          "email",
          "phone",
          "unit",
          "partySize",
          "plate",
          "purpose",
          "purposeType",
          "purposeOther",
          "note",
          "inAt",
          "outAt",
          "keep",
          "source",
          "status",
          "passAuthorized",
          "passAuthorizedAt",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.source == "self"
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == "訪客自填"
        && request.resource.data.qrToken == visitorId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 80
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.purposeType is string
        && request.resource.data.purposeType.size() <= 20
        && request.resource.data.purposeOther is string
        && request.resource.data.purposeOther.size() <= 40
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.keep == null
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.passAuthorized == false
        && request.resource.data.passAuthorizedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorPublicCreate(visitorId, slug) {
      return request.auth == null
        && request.resource.data.keys().hasOnly([
          "qrToken",
          "name",
          "email",
          "phone",
          "unit",
          "partySize",
          "plate",
          "purpose",
          "purposeType",
          "purposeOther",
          "note",
          "inAt",
          "outAt",
          "keep",
          "source",
          "status",
          "passAuthorized",
          "passAuthorizedAt",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.source == "self"
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == "public"
        && request.resource.data.createdByName == "訪客自填"
        && request.resource.data.qrToken == visitorId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 80
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.purposeType is string
        && request.resource.data.purposeType.size() <= 20
        && request.resource.data.purposeOther is string
        && request.resource.data.purposeOther.size() <= 40
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.keep == null
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.passAuthorized == false
        && request.resource.data.passAuthorizedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorResidentCreate(visitorId, slug) {
      let unitKeys = userUnitKeys();
      return request.auth != null
        && userCanAccessCommunitySlug(slug)
        && request.resource.data.keys().hasOnly([
          "qrToken",
          "name",
          "email",
          "phone",
          "unit",
          "partySize",
          "plate",
          "purpose",
          "purposeType",
          "purposeOther",
          "note",
          "inAt",
          "outAt",
          "keep",
          "source",
          "status",
          "passAuthorized",
          "passAuthorizedAt",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.source == "resident"
        && request.resource.data.status == "pending"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.qrToken == visitorId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() >= 1
        && request.resource.data.unit.size() <= 20
        && request.resource.data.unit in unitKeys
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 80
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data.purposeType is string
        && request.resource.data.purposeType.size() <= 20
        && request.resource.data.purposeOther is string
        && request.resource.data.purposeOther.size() <= 40
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.keep == null
        && request.resource.data.inAt == null
        && request.resource.data.outAt == null
        && request.resource.data.passAuthorized == false
        && request.resource.data.passAuthorizedAt == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorResidentCancel(slug) {
      let unitKeys = userUnitKeys();
      let currentStatus = resource.data.get('status', '');
      let allowedStatuses = ["pending", "approved"];
      return request.auth != null
        && userCanAccessCommunitySlug(slug)
        && request.resource.data.keys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "cancelled"
        && currentStatus in allowedStatuses
        && resource.data.get('unit', '') in unitKeys
        && resource.data.get('inAt', null) == null
        && resource.data.get('outAt', null) == null
        && request.resource.data.updatedAt is timestamp;
    }

    function isVisitorHouseholdGet(slug) {
      return request.auth != null
        && userCanAccessCommunitySlug(slug)
        && resource.data.get('unit', '') in userUnitKeys();
    }

    // 報到投票專案管理權（管理員或本社區工作人員）
    function isCheckinVoteManager(slug) {
      return request.auth != null
        && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
    }

    // 專案是否已封存（封存後全面鎖定，任何身分皆不得再寫入）
    function isCheckinVoteProjectArchived(slug, projectId) {
      return exists(/databases/$(database)/documents/communities/$(slug)/checkinVoteProjects/$(projectId))
        && get(/databases/$(database)/documents/communities/$(slug)/checkinVoteProjects/$(projectId)).data.get('archived', false) == true;
    }

    // 免登入掃碼可寫入的名單欄位（僅限報到與投票結果，不得竄改姓名／戶號／代碼）
    function checkinVotePublicRosterKeys() {
      return [
        "checkedIn", "checkedInAtMs", "checkedInMethod", "checkedInByUid", "checkedInByName",
        "votes", "updatedAt", "updatedAtMs"
      ];
    }

    // 免登入計票可寫入的選舉欄位（僅限票數快照）
    function checkinVotePublicElectionKeys() {
      return ["tally", "tallyUpdatedAtMs", "updatedAt", "updatedAtMs"];
    }

    match /users/{uid} {
      // 讀取：本人 / 管理方；待審申請文件僅限已登入者（不得匿名列舉、避免外洩聯絡資料）
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community)) ||
        (resource.data.status == "pending" && resource.data.role == "resident")
      );

      // 建立：管理方；或匿名送出待審申請（禁止夾帶特權欄位與明文密碼）
      allow create: if (request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(request.resource.data.community))
      )) || (
        request.resource.data.role == "resident" &&
        request.resource.data.status == "pending" &&
        request.resource.data.enabled == false &&
        request.resource.data.community is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.phone is string &&
        request.resource.data.get('points', 0) == 0 &&
        request.resource.data.get('password', null) == null &&
        request.resource.data.get('passwordPlain', null) == null &&
        request.resource.data.get('residentRoles', []) == [] &&
        request.resource.data.get('category', '') == '' &&
        (request.resource.data.houseNo == null || request.resource.data.houseNo is string) &&
        (request.resource.data.subUnit == null || request.resource.data.subUnit == "") &&
        (request.resource.data.passwordHash == null || request.resource.data.passwordHash is string) &&
        (request.resource.data.avatarDataUrl == null || request.resource.data.avatarDataUrl is string)
      );

      // 更新：管理方可全改；本人僅能改非特權欄位（不可提權 / 自灌點數 / 自行啟用 / 改戶號）
      allow update: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community))
      ) || (
        request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             "role", "points", "enabled", "houseNo", "subUnit", "unit", "community",
             "communityIds", "status", "uid", "permissions", "allowedModules", "isAdmin",
             "residentRoles", "residentRoleOther", "category", "password", "passwordPlain",
             "createdAt", "email"
           ])
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community))
      );

      match /wallet/{walletId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /parking_earnings/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /user_lookup/{phone} {
      // 單筆查詢用於「手機號碼 → Email」登入解析，維持可用
      allow get: if true;
      // 禁止未登入者或住戶列舉全部手機↔Email 對照
      allow list: if request.auth != null && isCommunityStaff();
      allow create: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(request.resource.data.community))
      );
      allow update, delete: if request.auth != null && (isAdmin() || isCommunityStaff());
    }

    match /communities/{slug} {
      allow read: if true;
      allow update: if request.auth != null && (
        isAdmin()
        || (
          isCommunityStaff()
          && userCanAccessCommunitySlug(slug)
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(["meterSettings","meterSettingsUpdatedAt","meterSettingsUpdatedBy"])
          ).implies(
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["meterSettings","meterSettingsUpdatedAt","meterSettingsUpdatedBy"])
          )
        )
      );
      allow create, delete: if isAdmin();

      match /app_modules/{module} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /announcements/{announceId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /bulletins/{bulletinId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      // 公告已讀清單：每位使用者只能寫自己的文件
      match /bulletinReads/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
        allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["ids", "updatedAt"])
          && request.resource.data.ids is list;
      }

      // 公告已讀計數：僅允許寫入計數欄位
      match /bulletinReadCounts/{bulletinId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.keys().hasOnly(["count", "updatedAt"])
          && request.resource.data.count is int
          && request.resource.data.count >= 0;
      }

      // 公告稽核軌跡（刪除等操作）
      match /bulletinAudit/{auditId} {
        allow read: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
        allow write: if request.auth != null && (isAdmin() || isCommunityStaff()) && userCanAccessCommunitySlug(slug);
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /careCheckins/{recordId} {
        allow read, write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /checkinVoteProjects/{projectId} {
        // 分享頁（checkin-vote-share.html）需免登入瀏覽，故此子樹開放公開讀取；
        // 寫入仍限管理員／社區人員。
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));

        match /roster/{entryId} {
          // 掃碼頁（qrcode-scan.html）可透過「分享」連結免登入操作報到與議題投票，
          // 故開放免登入「更新」既有名單；但仍限制如下：
          //   1. 僅能改寫報到與投票欄位（不得竄改姓名／戶號／QR 代碼）
          //   2. 不得新增或刪除名單（避免偽造住戶）
          //   3. 專案已封存時全面禁止寫入
          allow read: if true;
          allow create, delete: if isCheckinVoteManager(slug);
          allow update: if isCheckinVoteManager(slug)
            || (
              !isCheckinVoteProjectArchived(slug, projectId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(checkinVotePublicRosterKeys())
              && request.resource.data.get('checkedIn', false) is bool
              && request.resource.data.get('checkedInAtMs', 0) is int
              && request.resource.data.get('votes', {}) is map
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.get('updatedAtMs', 0) is int
            );
        }

        match /topics/{topicId} {
          allow read: if true;
          allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
        }

        match /documents/{documentId} {
          allow read, write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
        }

        match /elections/{electionId} {
          // 人工計票頁（election-count.html）可透過「分享」連結免登入唱票，
          // 故開放免登入「更新」既有選舉票數；但仍限：
          //   1. 僅能改寫票數快照（tally 等欄位）
          //   2. 不得新增或刪除選舉
          //   3. 專案已封存時全面禁止寫入
          allow read: if true;
          allow create, delete: if isCheckinVoteManager(slug);
          allow update: if isCheckinVoteManager(slug)
            || (
              !isCheckinVoteProjectArchived(slug, projectId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(checkinVotePublicElectionKeys())
              && request.resource.data.get('tally', {}) is map
              && request.resource.data.get('tallyUpdatedAtMs', 0) is int
              && request.resource.data.updatedAt is timestamp
              && request.resource.data.get('updatedAtMs', 0) is int
            );
        }
      }

      match /financeTx/{txId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeBank/{bankId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeBooks/{bookId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeConfig/{configId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeFee/{feeId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeBudgets/{budgetId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeNotices/{noticeId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /financeAudit/{auditId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /parking_spots/{spotId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          userCanAccessCommunitySlug(slug)
        );
      }

      match /parking_residents/{docId} {
        allow read, list: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug) || docId == request.auth.uid || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)) || docId == request.auth.uid || resource.data.uid == request.auth.uid);
      }

      match /parking_income_daily/{dayId} {
        allow read: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /parking_notifications/{nid} {
        allow read, list: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /facility_configs/{configId} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /reservations/{resId} {
        // 讀取：僅限本社區（管理方或該社區住戶），避免跨社區讀取住戶姓名／戶號
        allow read: if request.auth != null && (
          isAdmin() ||
          userCanAccessCommunitySlug(slug)
        );
        // 建立：狀態僅允許 pending/approved；住戶只能以自己的 uid 建立、且戶號須與自身相符
        allow create: if request.auth != null
          && request.resource.data.get('status', 'pending') in ["pending", "approved"]
          && request.resource.data.get('createdBy', '') != ''
          && (
            isAdmin() ||
            (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
            (
              request.resource.data.get('createdBy', '') == request.auth.uid
              && request.resource.data.get('unit', '') != ''
              && request.resource.data.get('unit', '') in userUnitKeys()
            )
          );
        // 更新：管理方可改狀態；住戶僅能取消自己建立、且尚未報到的預約
        allow update: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          (
            resource.data.get('createdBy', '') == request.auth.uid
            && request.resource.data.get('status', '') == "canceled"
            && resource.data.get('checkedIn', false) != true
          )
        );
        // 刪除：僅管理方
        allow delete: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      // 時段名額鎖（以交易寫入，避免併發超賣）
      match /slotLocks/{lockId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          userCanAccessCommunitySlug(slug)
        );
        allow create, update: if request.auth != null && (
          isAdmin() ||
          userCanAccessCommunitySlug(slug)
        );
        allow delete: if isAdmin();
      }

      // 預約稽核軌跡（僅新增與查詢，不可修改或刪除）
      match /reservationAudit/{auditId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
        allow create: if request.auth != null
          && request.resource.data.get('actorUid', '') == request.auth.uid;
        allow update, delete: if false;
      }

      match /mails/{mailId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          (getUserData().houseNo == resource.data.houseNo)
        );
        allow write: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      match /parcels/{parcelId} {
        allow read, write: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          (resource.data.unit in userUnitKeys()) ||
          (resource.data.houseNo in userUnitKeys())
        );
      }

      match /tempItems/{itemId} {
        allow read, write: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          (resource.data.unit in userUnitKeys())
        );
      }

      match /parcelAudit/{auditId} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /visitors/{visitorId} {
        allow get: if (request.auth != null && (
            isAdmin()
            || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
            || isVisitorSelfGet()
            || isVisitorHouseholdGet(slug)
            || (userCanAccessCommunitySlug(slug) && resource.data.get('createdBy', '') == request.auth.uid)
          )) || (
            resource.data.get('source', '') == "self"
            && resource.data.get('createdBy', '') == "public"
          );
        allow list: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || (userCanAccessCommunitySlug(slug) && resource.data.get('unit', '') in userUnitKeys())
          || (userCanAccessCommunitySlug(slug) && resource.data.get('createdBy', '') == request.auth.uid)
        );
        allow create: if (request.auth != null && (
            isAdmin()
            || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
            || isVisitorSelfCreate(visitorId)
            || isVisitorResidentCreate(visitorId, slug)
          )) || isVisitorPublicCreate(visitorId, slug);
        allow update: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || isVisitorResidentCancel(slug)
          || (userCanAccessCommunitySlug(slug)
              && resource.data.get('createdBy', '') == request.auth.uid
              && resource.data.get('inAt', null) == null
              && resource.data.get('outAt', null) == null
              && request.resource.data.keys().hasOnly(["status", "updatedAt"])
              && request.resource.data.status == "cancelled"
              && request.resource.data.updatedAt is timestamp)
        );
        allow delete: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      match /visitor_history/{unitKey} {
        allow read: if true;
        allow write: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /visitor_elevator_cards/{cardId} {
        allow read, write: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      match /points_logs/{logId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          (isCommunityStaff() && userCanAccessCommunitySlug(slug)) ||
          resource.data.houseNo == getUserData().houseNo
        );
        allow create: if request.auth != null;
      }

      match /pending_accounts/{reqId} {
        allow create: if request.resource.data.community == slug
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt is int
          && request.resource.data.get('photoDataUrl', '') is string
          && request.resource.data.houseNo is string
          && request.resource.data.displayName is string
          && request.resource.data.phone is string
          && request.resource.data.get('address', '') is string
          && request.resource.data.email is string
          && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.password is string
          && request.resource.data.password.matches('^[A-Za-z0-9]{6,}$');

        allow read, list, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      match /house_nos/{houseNoId} {
        allow read, list: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
        allow create, update, delete: if request.auth != null && (
          isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }

      match /parking_schedules/{sid} {
        allow read: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug) || resource.data.uid == request.auth.uid);
        allow write: if request.auth != null && (isAdmin() || (userCanAccessCommunitySlug(slug) && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid)));
      }

      match /parking_bookings/{bid} {
        allow read, list: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
        allow write: if request.auth != null && (isAdmin() || userCanAccessCommunitySlug(slug));
      }

      match /liveMeetingHistory/{docId} {
        allow read, list: if true;
        allow create, update, delete: if request.auth != null && (isAdmin() || (isCommunityStaff() && userCanAccessCommunitySlug(slug)));
      }

      match /meterReadings/{rid} {
        allow list: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || (userCanAccessCommunitySlug(slug) && (
              resource.data.houseNo in userUnitKeys()
              || resource.data.residentUid == request.auth.uid
              || resource.data.createdBy.uid == request.auth.uid
            ))
        );
        allow get: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || (userCanAccessCommunitySlug(slug) && (
              resource.data.houseNo in userUnitKeys()
              || resource.data.residentUid == request.auth.uid
              || resource.data.createdBy.uid == request.auth.uid
            ))
        );
        allow create: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || (userCanAccessCommunitySlug(slug)
              && request.resource.data.residentUid == request.auth.uid
              && (
                request.resource.data.houseNo in userUnitKeys()
                || request.resource.data.houseNo.size() >= 1
              )
            )
        );
        allow update: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
          || (resource.data.residentUid == request.auth.uid
              && request.resource.data.keys().hasOnly(["dispute", "updatedAt"])
            )
        );
        allow delete: if request.auth != null && (
          isAdmin()
          || (isCommunityStaff() && userCanAccessCommunitySlug(slug))
        );
      }
    }

    match /sos_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community))
      );
    }

    match /mail/{mailId} {
      allow create: if request.auth != null && (isAdmin() || isCommunityStaff());
      allow read, update, delete: if isAdmin();
    }

    match /pointsHistory/{historyId} {
      // 讀取：管理方或本人；寫入僅限管理方（避免住戶偽造點數歷程）
      allow read: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.communityId)) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(request.resource.data.communityId))
      );
      allow update, delete: if isAdmin();
    }

    function callExists(callId) {
      return exists(/databases/$(database)/documents/calls/$(callId));
    }

    function callData(callId) {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }

    function isCallParticipantByDoc(doc) {
      return request.auth != null && (
        doc.fromUid == request.auth.uid ||
        doc.toUid == request.auth.uid ||
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(doc.community))
      );
    }

    function isCallParticipant(callId) {
      return callExists(callId) && isCallParticipantByDoc(callData(callId));
    }

    match /calls/{callId} {
      allow create: if request.auth != null && (
        (
          userCanAccessUserCommunity(request.resource.data.community) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.fromRole in ["resident", "admin"] &&
          request.resource.data.status == "ringing"
        )
        ||
        isAdmin()
      );

      allow read, list: if request.auth != null && (
        isCallParticipantByDoc(resource.data) ||
        (resource.data.toUid == request.auth.uid) ||
        (resource.data.fromUid == request.auth.uid) ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community)) ||
        isAdmin()
      );

      allow update: if request.auth != null && isCallParticipantByDoc(resource.data);

      allow delete: if request.auth != null && (
        isAdmin() ||
        (isCommunityStaff() && userCanAccessUserCommunity(resource.data.community))
      );

      match /offerCandidates/{candidateId} {
        allow read, create: if request.auth != null && isCallParticipant(callId);
        allow update, delete: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read, create: if request.auth != null && isCallParticipant(callId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
